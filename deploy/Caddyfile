{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 8MB
	}

	reverse_proxy frontend:3000 {
		# This deployment exposes Caddy directly. Overwrite any client-supplied
		# forwarding headers with a private hop header derived from the socket.
		header_up X-Progyx-Client-IP {remote_host}
		health_uri /auth/login
		health_interval 30s
		health_timeout 5s
		transport http {
			dial_timeout 5s
			response_header_timeout 45s
		}
	}

	log {
		output stdout
		format json
	}
}
