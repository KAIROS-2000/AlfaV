# Copy this file outside the repository and inject its values through your
# deployment platform. Never use the development .env for production.
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Release attestations are fail-closed. Set to true only after attaching the
# corresponding evidence to the release record.
LEGAL_DOCUMENTS_APPROVED=false
MINOR_REGISTRATION_LEGAL_BASIS_APPROVED=false
HISTORICAL_GIGACHAT_INCIDENT_CLOSED=false
JUDGE_SANDBOX_HOST_VERIFIED=false
RESTORE_DRILL_VERIFIED=false
ONCALL_RUNBOOK_READY=false
TRANSACTIONAL_EMAIL_CANARY_VERIFIED=false
OBSERVABILITY_ALERTING_VERIFIED=false
BACKUP_ALERTING_VERIFIED=false

# Public TLS endpoint. Caddy obtains and renews the certificate automatically.
PUBLIC_DOMAIN=learn.example.com
PUBLIC_ORIGIN=https://learn.example.com
ACME_EMAIL=ops@example.com

# Immutable application artifacts built from one reviewed Git SHA.
PROGYX_IMAGE_TAG=replace-with-release-tag
BACKEND_IMAGE=registry.example.com/progyx/backend@sha256:replace-with-image-digest
FRONTEND_IMAGE=registry.example.com/progyx/frontend@sha256:replace-with-image-digest
JUDGE_RUNNER_IMAGE=registry.example.com/progyx/judge-runner@sha256:replace-with-image-digest
POSTGRES_IMAGE=registry.example.com/progyx/postgres@sha256:replace-with-image-digest
CADDY_IMAGE=registry.example.com/progyx/caddy@sha256:replace-with-image-digest
RESTIC_IMAGE=registry.example.com/progyx/restic@sha256:replace-with-image-digest

# Application secrets. Prefer platform secrets; values shown here are invalid
# placeholders and are intentionally rejected by production startup checks.
SECRET_KEY=replace-with-64-random-hex-characters
JWT_SIGNING_KEY_ID=production-current
JWT_SIGNING_KEYS=production-current=replace-with-64-random-hex-characters

# Compose reads database, Redis and judge credentials from ignored secret files:
#   secrets/postgres_password
#   secrets/redis_password
#   secrets/judge_runner_token
POSTGRES_PASSWORD_FILE_HOST=/secure/progyx/postgres_password
REDIS_PASSWORD_FILE_HOST=/secure/progyx/redis_password
JUDGE_RUNNER_TOKEN_FILE_HOST=/secure/progyx/judge_runner_token
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=codequest
POSTGRES_USER=codequest
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD_FILE=/run/secrets/redis_password

ENABLE_DEMO_DATA=false
SUPERADMIN_BOOTSTRAP=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict
TRUST_PROXY=true
SEND_MAIL=true
SEND_NOTIFICATION_EMAILS=true
EMAIL_DRY_RUN=false

EMAIL_PROVIDER=unisender_go
UNISENDER_GO_API_KEY=replace-with-provider-secret
UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Progyx
EMAIL_REPLY_TO=support@example.com

# Operator-approved public identity and versioned legal documents. Production
# frontend startup must reject the placeholder values.
NEXT_PUBLIC_SITE_URL=https://learn.example.com
LEGAL_OPERATOR_NAME=replace-with-approved-operator-name
LEGAL_OPERATOR_TAX_ID=replace-with-approved-tax-id
LEGAL_OPERATOR_REGISTRATION_ID=replace-with-approved-registration-id
LEGAL_OPERATOR_ADDRESS=replace-with-approved-legal-address
LEGAL_SUPPORT_EMAIL=support@example.com
LEGAL_SUPPORT_PHONE=replace-with-support-phone
LEGAL_DOCUMENTS_VERSION=replace-with-approved-version
LEGAL_DOCUMENTS_EFFECTIVE_DATE=replace-with-approved-effective-date
# Keep each approved document on one shell-safe line in this file. Platforms
# with secret/config stores may inject multiline values directly instead.
LEGAL_PRIVACY_CONTENT=replace-with-approved-privacy-policy-text
LEGAL_TERMS_CONTENT=replace-with-approved-user-agreement-text
LEGAL_PERSONAL_DATA_CONTENT=replace-with-approved-personal-data-consent-text

# Owned, monitored tournament source. Production has no hard-coded fallback URL.
TOURNAMENT_YANDEX_PUBLIC_URL=https://disk.yandex.ru/i/replace-with-owned-resource
TOURNAMENT_DATA_REFRESH_INTERVAL_SECONDS=1200

# External scheduler owns recurring jobs in production.
ENABLE_AUDIT_LOG_DAILY_EXPORT_THREAD=false
ENABLE_PARENT_WEEKLY_PROGRESS_EMAIL_THREAD=false

# Capacity defaults must be tuned after staging load tests.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=45
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
MAX_CONTENT_LENGTH_BYTES=8388608
BFF_MAX_REQUEST_BODY_BYTES=8388608
READINESS_REQUIRE_REDIS=true
READINESS_REQUIRE_JUDGE=true
READINESS_JUDGE_TIMEOUT_MS=500
PARENT_PASSWORD_SETUP_TOKEN_TTL_MINUTES=1440

# Encrypted off-host backup repository (for example s3:s3.amazonaws.com/bucket/path).
# These host files are mounted as Docker secrets and must not live in the checkout.
RESTIC_REPOSITORY=s3:s3.example.com/progyx-production/backups
RESTIC_PASSWORD_FILE_HOST=/secure/progyx/restic_password
BACKUP_ACCESS_KEY_ID_FILE_HOST=/secure/progyx/backup_access_key_id
BACKUP_SECRET_ACCESS_KEY_FILE_HOST=/secure/progyx/backup_secret_access_key
RESTIC_AUTO_INIT=false
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
